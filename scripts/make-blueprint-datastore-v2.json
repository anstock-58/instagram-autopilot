      },
      "metadata": {"designer": {"x": 0, "y": 0}}
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {"authenticationType": "noAuth"},
      "filter": {
        "name": "Reel",
        "conditions": [[{"a": "{{1.data.post_typ}}", "b": "Reel", "o": "text:equal"}]]
      },
      "mapper": {
        "url": "https://fal.run/fal-ai/kling-video/v2.1/standard/text-to-video",
