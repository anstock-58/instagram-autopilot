        "contentType": "application/json",
        "body": "{\"prompt\": \"{{1.data.videoprompt}}\", \"duration\": \"5\", \"aspect_ratio\": \"9:16\"}",
        "parseResponse": true,
        "timeout": 300,
        "allowRedirects": true,
        "shareCookies": false,
        "stopOnHttpError": true,
        "requestCompressedContent": false
