{"content":{"raw":"\u003cstyle\u003e\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --bg:       #0D0D10;\n    --surface:  #16161C;\n    --border:   #2A2A35;\n    --gold:     #C8A96E;\n    --gold-dim: #9E7E4A;\n    --text:     #E8E6E0;\n    --muted:    #8A8880;\n    --red:      #C84A4A;\n  }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    background: #0D0D10;\n    color: #E8E6E0;\n    font-family: \u0027Georgia\u0027, serif;\n    font-size: 17px;\n    line-height: 1.75;\n    overflow-x: hidden;\n  }\n\n  /* SCOPED WRAPPER — erzwingt Dark Theme auch in WordPress */\n  #lp {\n    background: #0D0D10 !important;\n    color: #E8E6E0 !important;\n    font-family: \u0027Georgia\u0027, serif !important;\n    font-size: 17px;\n    line-height: 1.75;\n    overflow-x: hidden;\n    min-height: 100vh;\n    padding-bottom: 80px; /* Platz für Sticky Bar */\n  }\n  #lp * { box-sizing: border-box; }\n  #lp p { margin-bottom: 16px; }\n  #lp p:last-child { margin-bottom: 0; }\n\n  /* NAV */\n  #lp-nav {\n    position: fixed; top: 0; left: 0; right: 0; z-index: 200;\n    padding: 18px 32px;\n    display: flex; justify-content: space-between; align-items: center;\n    transition: background 0.4s, backdrop-filter 0.4s;\n  }\n  #lp-nav.scrolled {\n    background: rgba(13,13,16,0.95);\n    backdrop-filter: blur(12px);\n    border-bottom: 1px solid #2A2A35;\n  }\n  .lp-nav-logo { color: #C8A96E; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; font-family: sans-serif; }\n  .lp-nav-cta {\n    background: #C8A96E; color: #0D0D10 !important;\n    padding: 10px 24px; border-radius: 4px;\n    font-size: 13px; font-family: sans-serif; font-weight: 800;\n    text-decoration: none !important; letter-spacing: 0.04em; text-transform: uppercase;\n    transition: opacity 0.2s; white-space: nowrap;\n  }\n  .lp-nav-cta:hover { opacity: 0.85; }\n\n  /* HERO */\n  .lp-hero {\n    min-height: 100vh;\n    display: flex; align-items: center;\n    padding: 120px 24px 100px;\n    background:\n      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(200,169,110,0.08) 0%, transparent 70%),\n      linear-gradient(180deg, #0D0D10 0%, #111118 100%);\n    text-align: center;\n  }\n  .lp-hero-inner { max-width: 720px; margin: 0 auto; }\n\n  .lp-tag {\n    display: inline-block;\n    border: 1px solid #9E7E4A;\n    color: #C8A96E;\n    font-family: sans-serif; font-size: 11px; font-weight: 700;\n    letter-spacing: 0.18em; text-transform: uppercase;\n    padding: 6px 16px; border-radius: 2px;\n    margin-bottom: 28px;\n    opacity: 0;\n    animation: lpFadeUp 0.7s ease forwards 0.2s;\n  }\n\n  #lp h1 {\n    font-size: clamp(36px, 6vw, 62px);\n    font-weight: 400; line-height: 1.15;\n    color: #fff !important;\n    opacity: 0;\n    animation: lpFadeUp 0.8s ease forwards 0.4s;\n    font-family: \u0027Georgia\u0027, serif;\n    margin: 0 0 24px;\n  }\n  #lp h1 em { color: #C8A96E; font-style: normal; }\n\n  #lp h2 {\n    font-size: clamp(26px, 4vw, 38px);\n    font-weight: 400; line-height: 1.2;\n    color: #fff !important; margin-bottom: 24px;\n    font-family: \u0027Georgia\u0027, serif;\n  }\n  #lp h2 em { color: #C8A96E; font-style: normal; }\n\n  #lp h3 { font-size: 18px; font-weight: 400; color: #fff !important; margin-bottom: 6px; font-family: \u0027Georgia\u0027, serif; }\n\n  .lp-hero-sub {\n    font-size: clamp(16px, 2.2vw, 19px);\n    color: #8A8880;\n    opacity: 0;\n    animation: lpFadeUp 0.8s ease forwards 0.6s;\n    margin-bottom: 16px;\n  }\n\n  .lp-hero-price {\n    font-family: sans-serif; font-size: 15px;\n    color: #8A8880;\n    opacity: 0;\n    animation: lpFadeUp 0.6s ease forwards 0.75s;\n    margin-bottom: 0;\n  }\n  .lp-hero-price strong { color: #E8E6E0; }\n\n  .lp-hero-btn {\n    display: inline-block; margin-top: 36px;\n    background: #C8A96E; color: #0D0D10 !important;\n    padding: 20px 56px; border-radius: 6px;\n    font-family: sans-serif; font-weight: 800; font-size: 18px;\n    letter-spacing: 0.04em; text-transform: uppercase;\n    text-decoration: none !important;\n    transition: transform 0.2s, box-shadow 0.2s;\n    opacity: 0;\n    animation: lpFadeUp 0.7s ease forwards 0.9s;\n    box-shadow: 0 4px 24px rgba(200,169,110,0.3);\n  }\n  .lp-hero-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 36px rgba(200,169,110,0.4); }\n\n  .lp-hero-note {\n    font-family: sans-serif; font-size: 12px; color: #8A8880;\n    opacity: 0;\n    animation: lpFadeUp 0.6s ease forwards 1.05s;\n    margin-top: 12px; margin-bottom: 0;\n  }\n\n  /* SECTIONS */\n  #lp section { padding: 90px 24px; }\n  #lp .lp-container { max-width: 780px; margin: 0 auto; }\n\n  .lp-label {\n    font-family: sans-serif; font-size: 11px; font-weight: 700;\n    letter-spacing: 0.18em; text-transform: uppercase;\n    color: #C8A96E; margin-bottom: 12px; display: block;\n  }\n\n  #lp p { color: #8A8880; }\n\n  /* PAIN */\n  .lp-pain { background: #16161C !important; border-top: 1px solid #2A2A35; border-bottom: 1px solid #2A2A35; }\n  .lp-pain-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 28px; margin-top: 40px; }\n  .lp-pain-item {\n    background: #0D0D10 !important;\n    border: 1px solid #2A2A35; border-radius: 6px;\n    padding: 24px 22px;\n  }\n  .lp-pain-item .lp-icon { font-size: 28px; margin-bottom: 12px; }\n  .lp-pain-item p { font-size: 15px; margin: 0; }\n\n  /* MODULES */\n  .lp-module-section { background: #16161C !important; border-top: 1px solid #2A2A35; border-bottom: 1px solid #2A2A35; }\n  .lp-module-list { margin-top: 44px; display: flex; flex-direction: column; gap: 20px; }\n  .lp-module-item {\n    display: flex; gap: 20px; align-items: flex-start;\n    background: #0D0D10 !important; border: 1px solid #2A2A35; border-radius: 6px;\n    padding: 24px 26px;\n  }\n  .lp-module-num {\n    flex-shrink: 0; width: 44px; height: 44px;\n    border: 1px solid #9E7E4A; border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    font-family: sans-serif; font-size: 16px; font-weight: 800;\n    color: #C8A96E; margin-top: 2px;\n  }\n\n  /* INCLUDED */\n  .lp-included-list { margin-top: 36px; display: flex; flex-direction: column; gap: 14px; }\n  .lp-included-item {\n    display: flex; gap: 16px; align-items: flex-start;\n    padding: 18px 22px;\n    background: #16161C !important; border: 1px solid #2A2A35; border-radius: 6px;\n  }\n  .lp-check { color: #C8A96E; font-size: 20px; flex-shrink: 0; margin-top: 2px; }\n  .lp-included-item p { font-size: 15px; margin: 0; }\n\n  /* FOR WHO */\n  .lp-for-who { background: #16161C !important; border-top: 1px solid #2A2A35; border-bottom: 1px solid #2A2A35; }\n  .lp-who-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 36px; }\n  .lp-who-yes, .lp-who-no {\n    display: flex; gap: 12px; align-items: flex-start;\n    padding: 16px 18px; border-radius: 6px;\n    background: #0D0D10 !important; border: 1px solid #2A2A35;\n    font-size: 15px; color: #8A8880;\n  }\n  .lp-who-yes span:first-child { color: #5FCF80; font-size: 17px; flex-shrink: 0; }\n  .lp-who-no span:first-child  { color: #C84A4A; font-size: 17px; flex-shrink: 0; }\n\n  /* PRICE */\n  .lp-price-card {\n    max-width: 540px; margin: 48px auto 0;\n    background: #16161C !important; border: 2px solid #9E7E4A; border-radius: 10px;\n    padding: 48px 44px; text-align: center;\n  }\n  .lp-price-title { font-size: 22px; color: #fff !important; margin-bottom: 4px; font-family: Georgia, serif; }\n  .lp-price-sub { font-family: sans-serif; font-size: 13px; color: #8A8880; margin-bottom: 28px; }\n  .lp-price-amount { font-size: 72px; font-weight: 400; color: #C8A96E !important; line-height: 1; margin-bottom: 4px; font-family: Georgia, serif; }\n  .lp-price-tax { font-family: sans-serif; font-size: 13px; color: #8A8880; margin-bottom: 28px; }\n  .lp-price-list { text-align: left; margin-bottom: 32px; display: flex; flex-direction: column; gap: 10px; }\n  .lp-price-list-item { display: flex; gap: 12px; align-items: flex-start; font-size: 15px; color: #8A8880; }\n  .lp-price-list-item span:first-child { color: #C8A96E; flex-shrink: 0; }\n\n  .lp-price-btn {\n    display: block; width: 100%;\n    background: #C8A96E !important; color: #0D0D10 !important;\n    padding: 20px 24px; border-radius: 6px;\n    font-family: sans-serif; font-weight: 800; font-size: 18px;\n    letter-spacing: 0.04em; text-transform: uppercase;\n    text-decoration: none !important;\n    transition: transform 0.2s, box-shadow 0.2s;\n    box-shadow: 0 4px 24px rgba(200,169,110,0.3);\n  }\n  .lp-price-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(200,169,110,0.4); }\n  .lp-price-guarantee { font-family: sans-serif; font-size: 12px; color: #8A8880; margin-top: 14px; }\n\n  /* MID-PAGE CTA */\n  .lp-mid-cta {\n    text-align: center; padding: 60px 24px;\n    background: linear-gradient(135deg, rgba(200,169,110,0.06) 0%, rgba(13,13,16,0) 60%);\n    border-top: 1px solid #2A2A35; border-bottom: 1px solid #2A2A35;\n  }\n  .lp-mid-cta p { font-size: 18px; color: #E8E6E0 !important; margin-bottom: 8px; }\n  .lp-mid-cta-btn {\n    display: inline-block; margin-top: 24px;\n    background: #C8A96E; color: #0D0D10 !important;\n    padding: 18px 52px; border-radius: 6px;\n    font-family: sans-serif; font-weight: 800; font-size: 17px;\n    letter-spacing: 0.04em; text-transform: uppercase;\n    text-decoration: none !important;\n    transition: transform 0.2s, box-shadow 0.2s;\n    box-shadow: 0 4px 24px rgba(200,169,110,0.3);\n  }\n  .lp-mid-cta-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 36px rgba(200,169,110,0.4); }\n\n  /* UPSELL HINT */\n  .lp-upsell {\n    background: rgba(200,169,110,0.05) !important;\n    border: 1px solid rgba(200,169,110,0.2);\n    border-radius: 8px;\n    padding: 32px 36px; margin-top: 60px; text-align: center;\n  }\n  .lp-upsell p { font-size: 16px; color: #8A8880; }\n  .lp-upsell strong { color: #C8A96E; }\n\n  /* FAQ */\n  .lp-faq { background: #16161C !important; border-top: 1px solid #2A2A35; border-bottom: 1px solid #2A2A35; }\n  .lp-faq-list { margin-top: 40px; display: flex; flex-direction: column; gap: 2px; }\n  .lp-faq-item { border-bottom: 1px solid #2A2A35; }\n  .lp-faq-q {\n    width: 100%; background: none !important; border: none; cursor: pointer;\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 20px 0; color: #fff !important; font-size: 16px; font-family: inherit;\n    text-align: left; gap: 16px;\n  }\n  .lp-faq-q .lp-arrow { color: #C8A96E; font-size: 20px; flex-shrink: 0; transition: transform 0.3s; }\n  .lp-faq-q.open .lp-arrow { transform: rotate(45deg); }\n  .lp-faq-a { display: none; padding-bottom: 20px; font-size: 15px; }\n  .lp-faq-a.open { display: block; }\n\n  /* FOOTER */\n  #lp footer {\n    padding: 48px 24px;\n    text-align: center;\n    border-top: 1px solid #2A2A35;\n    font-family: sans-serif; font-size: 13px; color: #8A8880;\n  }\n  #lp footer a { color: #8A8880 !important; text-decoration: underline; }\n\n  /* STICKY BOTTOM BAR */\n  #lp-sticky {\n    position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;\n    background: #1A1A1F;\n    border-top: 1px solid #2A2A35;\n    padding: 12px 24px;\n    display: flex; align-items: center; justify-content: center; gap: 20px;\n    box-shadow: 0 -4px 30px rgba(0,0,0,0.6);\n  }\n  #lp-sticky .lp-sticky-text {\n    font-family: sans-serif; font-size: 14px; color: #8A8880; white-space: nowrap;\n  }\n  #lp-sticky .lp-sticky-text strong { color: #E8E6E0; }\n  #lp-sticky .lp-sticky-btn {\n    background: #C8A96E; color: #0D0D10 !important;\n    padding: 12px 36px; border-radius: 4px;\n    font-family: sans-serif; font-weight: 800; font-size: 15px;\n    text-decoration: none !important; letter-spacing: 0.04em; text-transform: uppercase;\n    white-space: nowrap; transition: opacity 0.2s;\n  }\n  #lp-sticky .lp-sticky-btn:hover { opacity: 0.9; }\n\n  /* REVEAL */\n  .lp-reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.7s ease, transform 0.7s ease; }\n  .lp-reveal.visible { opacity: 1; transform: translateY(0); }\n\n  @keyframes lpFadeUp {\n    from { opacity: 0; transform: translateY(30px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n\n  @media (max-width: 640px) {\n    #lp-nav { padding: 14px 20px; }\n    .lp-nav-logo { font-size: 12px; }\n    #lp section { padding: 60px 20px; }\n    .lp-who-grid { grid-template-columns: 1fr; }\n    .lp-price-card { padding: 32px 24px; }\n    .lp-price-amount { font-size: 56px; }\n    .lp-upsell { padding: 24px 20px; }\n    #lp-sticky .lp-sticky-text { display: none; }\n    #lp-sticky .lp-sticky-btn { width: 100%; text-align: center; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .lp-tag, #lp h1, .lp-hero-sub, .lp-hero-price, .lp-hero-btn, .lp-hero-note { animation: none; opacity: 1; }\n    .lp-reveal { opacity: 1; transform: none; transition: none; }\n  }\n\u003c/style\u003e\n\n\u003cdiv id=\"lp\"\u003e\n\n\u003c!-- NAV --\u003e\n\u003cnav id=\"lp-nav\"\u003e\n  \u003ca href=\"#\" class=\"lp-nav-logo\"\u003eAndreas Stock\u003c/a\u003e\n  \u003ca href=\"https://app.alfima.com/products/preview/27615\" class=\"lp-nav-cta\"\u003eJetzt starten — 37 €\u003c/a\u003e\n\u003c/nav\u003e\n\n\u003c!-- HERO --\u003e\n\u003csection class=\"lp-hero\"\u003e\n  \u003cdiv class=\"lp-hero-inner\"\u003e\n    \u003cdiv class=\"lp-tag\"\u003eMinikurs · Sofortiger Zugriff\u003c/div\u003e\n    \u003ch1\u003eDu funktionierst.\u003cbr\u003eAber irgendwie\u003cbr\u003ereicht es dir nicht mehr.\u003c/h1\u003e\n    \u003cp class=\"lp-hero-sub\"\u003eVersteh in drei Modulen, warum du im Autopilot steckst — und mach die ersten Schritte raus. Ohne Druck. In deinem Tempo.\u003c/p\u003e\n    \u003cp class=\"lp-hero-price\"\u003eEinmaliger Zugang · \u003cstrong\u003e37 € inkl. MwSt.\u003c/strong\u003e\u003c/p\u003e\n    \u003ca href=\"https://app.alfima.com/products/preview/27615\" class=\"lp-hero-btn\"\u003eJetzt Zugang sichern →\u003c/a\u003e\n    \u003cp class=\"lp-hero-note\"\u003eSofortiger digitaler Zugriff nach dem Kauf · Keine Kreditkarte ohne Kauf\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PAIN --\u003e\n\u003csection class=\"lp-pain\"\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eDas kennst du\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003eNach außen alles im Griff.\u003cbr\u003e\u003cem\u003eInnen schon lange nicht mehr.\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-pain-grid\"\u003e\n      \u003cdiv class=\"lp-pain-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-icon\"\u003e⚙️\u003c/div\u003e\n        \u003cp\u003eDu erledigst, was ansteht. Aber ein echtes „Ja\" dazu fühlst du schon lange nicht mehr.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-pain-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-icon\"\u003e🔇\u003c/div\u003e\n        \u003cp\u003eStress-Tipps aus dem Internet hast du alle probiert. Sie greifen nicht — weil sie das falsche Problem lösen.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-pain-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-icon\"\u003e🧱\u003c/div\u003e\n        \u003cp\u003eDu weißt, dass sich etwas ändern muss. Aber du hast keine Energie mehr, wieder irgendwo neu anzufangen.\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PROMISE --\u003e\n\u003csection\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eWas dieser Kurs tut\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003eKein Coaching. Kein Druck.\u003cbr\u003e\u003cem\u003eNur Klarheit, wo es anfängt.\u003c/em\u003e\u003c/h2\u003e\n    \u003cp class=\"lp-reveal\"\u003eDieser Kurs erklärt, warum du im Funktionsmodus gelandet bist — und was das mit dir macht. Kein Schönreden, keine Überforderung. Du nimmst mit, was gerade für dich passt, und lässt den Rest.\u003c/p\u003e\n    \u003cp class=\"lp-reveal\"\u003eGedacht für Selbstständige, Unternehmer und Führungskräfte ab 50, die nach außen funktionieren und innerlich spüren: So kann es nicht weitergehen.\u003c/p\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- MODULES --\u003e\n\u003csection class=\"lp-module-section\"\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eDie drei Module\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003eEin klarer Weg.\u003cbr\u003e\u003cem\u003eDrei Schritte.\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-module-list\"\u003e\n      \u003cdiv class=\"lp-module-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-module-num\"\u003e1\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch3\u003eDen Funktionsmodus verstehen\u003c/h3\u003e\n          \u003cp\u003eWas er ist, woher er kommt — und warum klassische Stress-Bewältigung daran scheitert.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-module-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-module-num\"\u003e2\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch3\u003eDie Mechanismen dahinter\u003c/h3\u003e\n          \u003cp\u003eWas in dir passiert, wenn du dauerhaft funktionierst. Warum du dich selbst dabei verlierst — und es trotzdem immer weitergeht.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-module-item lp-reveal\"\u003e\n        \u003cdiv class=\"lp-module-num\"\u003e3\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003ch3\u003eVom Funktionieren zum Fühlen\u003c/h3\u003e\n          \u003cp\u003eErste konkrete Schritte raus aus dem Autopilot. Kein großer Umbau — nur das, was jetzt möglich ist.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- MID-PAGE CTA --\u003e\n\u003cdiv class=\"lp-mid-cta lp-reveal\"\u003e\n  \u003cp\u003e\u003cstrong style=\"color:#C8A96E;\"\u003e37 €\u003c/strong\u003e — einmalig, sofortiger Zugriff, kein Abo.\u003c/p\u003e\n  \u003cp style=\"font-size:15px;\"\u003eDrei Module. In deinem Tempo. Kein Druck.\u003c/p\u003e\n  \u003ca href=\"https://app.alfima.com/products/preview/27615\" class=\"lp-mid-cta-btn\"\u003eJetzt Zugang sichern →\u003c/a\u003e\n\u003c/div\u003e\n\n\u003c!-- INCLUDED --\u003e\n\u003csection\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eWas du bekommst\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003eKurz. Konkret. \u003cem\u003eSofort nutzbar.\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-included-list\"\u003e\n      \u003cdiv class=\"lp-included-item lp-reveal\"\u003e\n        \u003cspan class=\"lp-check\"\u003e▸\u003c/span\u003e\n        \u003cp\u003eAlle Video-Lektionen — kurz, klar, ohne Füller\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-included-item lp-reveal\"\u003e\n        \u003cspan class=\"lp-check\"\u003e▸\u003c/span\u003e\n        \u003cp\u003eKurze Zusammenfassungen und Mini-Aufgaben direkt in den Lektionen\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-included-item lp-reveal\"\u003e\n        \u003cspan class=\"lp-check\"\u003e▸\u003c/span\u003e\n        \u003cp\u003ePraktische Impulse, die du sofort umsetzen kannst — ohne Vorbereitung\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-included-item lp-reveal\"\u003e\n        \u003cspan class=\"lp-check\"\u003e▸\u003c/span\u003e\n        \u003cp\u003eSofortiger Zugriff nach dem Kauf, dauerhaft im Mitgliederbereich\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FOR WHO --\u003e\n\u003csection class=\"lp-for-who\"\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eFür wen — und für wen nicht\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003ePasst dieser Kurs\u003cbr\u003e\u003cem\u003ezu dir?\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-who-grid\"\u003e\n      \u003cdiv class=\"lp-who-yes lp-reveal\"\u003e\u003cspan\u003e✓\u003c/span\u003e\u003cspan\u003eDu funktionierst nach außen, aber innerlich spürst du Leere oder Druck\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"lp-who-no  lp-reveal\"\u003e\u003cspan\u003e✗\u003c/span\u003e\u003cspan\u003eDu erwartest Coaching, Community oder Live-Betreuung\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"lp-who-yes lp-reveal\"\u003e\u003cspan\u003e✓\u003c/span\u003e\u003cspan\u003eDu bist 50+, selbstständig oder in Führung und willst endlich verstehen, was mit dir passiert\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"lp-who-no  lp-reveal\"\u003e\u003cspan\u003e✗\u003c/span\u003e\u003cspan\u003eDu willst eine schnelle Technik-Sammlung ohne Hintergrundverständnis\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"lp-who-yes lp-reveal\"\u003e\u003cspan\u003e✓\u003c/span\u003e\u003cspan\u003eDu willst in deinem Tempo, ohne Druck und ohne komplizierte Methoden\u003c/span\u003e\u003c/div\u003e\n      \u003cdiv class=\"lp-who-no  lp-reveal\"\u003e\u003cspan\u003e✗\u003c/span\u003e\u003cspan\u003eDu suchst eine umfassende 1:1-Transformation — dafür gibt es den Hauptkurs\u003c/span\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PRICE --\u003e\n\u003csection\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\" style=\"text-align:center; display:block;\"\u003eDein Zugang\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\" style=\"text-align:center;\"\u003eEinmal kaufen.\u003cbr\u003e\u003cem\u003eDauerhaft nutzen.\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-price-card lp-reveal\"\u003e\n      \u003cp class=\"lp-price-title\"\u003eRaus aus dem Funktionsmodus\u003c/p\u003e\n      \u003cp class=\"lp-price-sub\"\u003eMinikurs · Sofortzugang · Eigenes Tempo\u003c/p\u003e\n      \u003cdiv class=\"lp-price-amount\"\u003e37 €\u003c/div\u003e\n      \u003cp class=\"lp-price-tax\"\u003einkl. MwSt. · einmalig\u003c/p\u003e\n      \u003cdiv class=\"lp-price-list\"\u003e\n        \u003cdiv class=\"lp-price-list-item\"\u003e\u003cspan\u003e▸\u003c/span\u003e\u003cspan\u003eDrei Module, kurze Lektionen\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"lp-price-list-item\"\u003e\u003cspan\u003e▸\u003c/span\u003e\u003cspan\u003eMini-Aufgaben und Zusammenfassungen\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"lp-price-list-item\"\u003e\u003cspan\u003e▸\u003c/span\u003e\u003cspan\u003eSofortiger Zugriff, dauerhaft verfügbar\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"lp-price-list-item\"\u003e\u003cspan\u003e▸\u003c/span\u003e\u003cspan\u003eKein Abo, keine versteckten Kosten\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"lp-price-list-item\"\u003e\u003cspan\u003e▸\u003c/span\u003e\u003cspan\u003eSupport: info@ansto-finaffairs.com\u003c/span\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003ca href=\"https://app.alfima.com/products/preview/27615\" class=\"lp-price-btn\"\u003eJetzt Zugang sichern →\u003c/a\u003e\n      \u003cp class=\"lp-price-guarantee\"\u003eDigitales Produkt · Sofortiger Zugriff nach dem Kauf\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"lp-upsell lp-reveal\"\u003e\n      \u003cp\u003eWenn du beim Anschauen merkst: \u003cstrong\u003eGenau das trifft mich — ich will tiefer ran\u003c/strong\u003e, gibt es eine nächste Stufe.\u003cbr\u003eDen Hinweis bekommst du im Kurs an der richtigen Stelle. Nicht am Anfang.\u003c/p\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FAQ --\u003e\n\u003csection class=\"lp-faq\"\u003e\n  \u003cdiv class=\"lp-container\"\u003e\n    \u003cspan class=\"lp-label lp-reveal\"\u003eHäufige Fragen\u003c/span\u003e\n    \u003ch2 class=\"lp-reveal\"\u003eWas du noch\u003cbr\u003e\u003cem\u003ewissen willst\u003c/em\u003e\u003c/h2\u003e\n    \u003cdiv class=\"lp-faq-list lp-reveal\"\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eWie lange habe ich Zugriff?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eDauerhaft. Nach dem Kauf gehört dir der Zugang — ohne Ablaufdatum.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eWie lange dauert der Kurs?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eDer Kurs ist bewusst kurz gehalten. Drei Module mit kompakten Lektionen — du kannst ihn an einem Wochenende durcharbeiten oder in deinem eigenen Tempo über mehrere Tage verteilen.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eBrauche ich Vorkenntnisse?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eNein. Der Kurs ist als Einstieg konzipiert. Kein Vorwissen nötig, keine Vorbereitung.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eWas ist der Unterschied zum Hauptkurs „Neustart im Kopf\"?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eDieser Minikurs ist der Einstieg — verstehen, wo du stehst, erste Entlastung. „Neustart im Kopf\" baut darauf auf: mehr Tiefe, mehr Struktur, mehr Umsetzung im Alltag. Der richtige Zeitpunkt dafür ergibt sich im Kurs selbst.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eGibt es Live-Calls oder eine Community?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eNein. Kein Coaching, keine Community, keine Live-Termine. Du lernst unabhängig, in deinem Tempo — das ist bewusst so gedacht.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"lp-faq-item\"\u003e\n        \u003cbutton class=\"lp-faq-q\"\u003eWie läuft der Kauf ab?\u003cspan class=\"lp-arrow\"\u003e+\u003c/span\u003e\u003c/button\u003e\n        \u003cdiv class=\"lp-faq-a\"\u003e\u003cp\u003eNach dem Kauf bekommst du sofort Zugang zum digitalen Mitgliederbereich. Bei technischen Fragen: info@ansto-finaffairs.com.\u003c/p\u003e\u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FOOTER --\u003e\n\u003cfooter\u003e\n  \u003cp\u003e© 2026 Andreas Stock · \u003ca href=\"mailto:info@ansto-finaffairs.com\"\u003einfo@ansto-finaffairs.com\u003c/a\u003e\u003c/p\u003e\n  \u003cp style=\"margin-top: 8px;\"\u003e\u003ca href=\"#\"\u003eImpressum\u003c/a\u003e · \u003ca href=\"#\"\u003eDatenschutz\u003c/a\u003e\u003c/p\u003e\n\u003c/footer\u003e\n\n\u003c/div\u003e\u003c!-- #lp --\u003e\n\n\u003c!-- STICKY CTA BAR — immer sichtbar, 100% inline --\u003e\n\u003cdiv id=\"lp-sticky\"\u003e\n  \u003cspan class=\"lp-sticky-text\"\u003eMinikurs · \u003cstrong\u003e37 € einmalig\u003c/strong\u003e · Sofortzugang\u003c/span\u003e\n  \u003ca href=\"https://app.alfima.com/products/preview/27615\" class=\"lp-sticky-btn\"\u003eJetzt kaufen →\u003c/a\u003e\n\u003c/div\u003e\n\n\u003cscript\u003e\n  // Nav scroll\n  const lpNav = document.getElementById(\u0027lp-nav\u0027);\n  if (lpNav) window.addEventListener(\u0027scroll\u0027, () =\u003e {\n    lpNav.classList.toggle(\u0027scrolled\u0027, window.scrollY \u003e 40);\n  });\n\n  // Reveal on scroll\n  const lpObserver = new IntersectionObserver((entries) =\u003e {\n    entries.forEach(e =\u003e {\n      if (e.isIntersecting) { e.target.classList.add(\u0027visible\u0027); lpObserver.unobserve(e.target); }\n    });\n  }, { threshold: 0.1 });\n  document.querySelectorAll(\u0027.lp-reveal\u0027).forEach(el =\u003e lpObserver.observe(el));\n\n  // FAQ\n  document.querySelectorAll(\u0027.lp-faq-q\u0027).forEach(btn =\u003e {\n    btn.addEventListener(\u0027click\u0027, () =\u003e {\n      const isOpen = btn.classList.contains(\u0027open\u0027);\n      document.querySelectorAll(\u0027.lp-faq-q\u0027).forEach(b =\u003e { b.classList.remove(\u0027open\u0027); b.nextElementSibling.classList.remove(\u0027open\u0027); });\n      if (!isOpen) { btn.classList.add(\u0027open\u0027); btn.nextElementSibling.classList.add(\u0027open\u0027); }\n    });\n  });\n\u003c/script\u003e\n"}}