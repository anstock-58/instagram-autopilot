{"title":"Neustart im Kopf","content":{"raw":"\u003cstyle\u003e\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --bg: #0D0D10;\n    --bg2: #13131A;\n    --bg3: #1A1A24;\n    --accent: #C8A96E;\n    --accent2: #A8894E;\n    --text: #E8E8F0;\n    --muted: #888899;\n    --border: rgba(200,169,110,0.15);\n    --white: #ffffff;\n  }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: \u0027Inter\u0027, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.7;\n    overflow-x: hidden;\n  }\n\n  /* NAV */\n  nav {\n    position: fixed;\n    top: 0; left: 0; right: 0;\n    z-index: 100;\n    padding: 20px 40px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    transition: background 0.4s, backdrop-filter 0.4s;\n  }\n  nav.scrolled {\n    background: rgba(13,13,16,0.92);\n    backdrop-filter: blur(20px);\n    border-bottom: 1px solid var(--border);\n  }\n  .nav-logo {\n    font-size: 18px;\n    font-weight: 600;\n    color: var(--accent);\n    letter-spacing: 0.05em;\n  }\n  .nav-cta {\n    background: var(--accent);\n    color: #0D0D10;\n    border: none;\n    padding: 10px 24px;\n    border-radius: 6px;\n    font-weight: 600;\n    font-size: 14px;\n    cursor: pointer;\n    text-decoration: none;\n    transition: background 0.2s, transform 0.2s;\n  }\n  .nav-cta:hover { background: var(--accent2); transform: translateY(-1px); }\n\n  /* HERO */\n  .hero {\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 120px 24px 80px;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-bg {\n    position: absolute;\n    inset: 0;\n    background:\n      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(200,169,110,0.12) 0%, transparent 60%),\n      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(200,169,110,0.06) 0%, transparent 50%);\n  }\n  .hero-content {\n    position: relative;\n    max-width: 780px;\n    margin: 0 auto;\n  }\n  .hero-badge {\n    display: inline-block;\n    background: rgba(200,169,110,0.1);\n    border: 1px solid var(--border);\n    color: var(--accent);\n    padding: 6px 18px;\n    border-radius: 100px;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    margin-bottom: 32px;\n    opacity: 0;\n    animation: fadeUp 0.8s ease 0.2s forwards;\n  }\n  .hero h1 {\n    font-size: clamp(38px, 6vw, 72px);\n    font-weight: 700;\n    line-height: 1.1;\n    letter-spacing: -0.02em;\n    margin-bottom: 28px;\n    opacity: 0;\n    animation: fadeUp 0.8s ease 0.4s forwards;\n  }\n  .hero h1 span {\n    background: linear-gradient(135deg, var(--accent), #E8D5A8);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n  .hero-sub {\n    font-size: clamp(17px, 2.5vw, 21px);\n    color: var(--muted);\n    max-width: 580px;\n    margin: 0 auto 48px;\n    font-weight: 400;\n    opacity: 0;\n    animation: fadeUp 0.8s ease 0.6s forwards;\n  }\n  .hero-cta-group {\n    display: flex;\n    gap: 16px;\n    justify-content: center;\n    flex-wrap: wrap;\n    opacity: 0;\n    animation: fadeUp 0.8s ease 0.8s forwards;\n  }\n  .btn-primary {\n    display: inline-block;\n    background: var(--accent);\n    color: #0D0D10;\n    padding: 16px 40px;\n    border-radius: 8px;\n    font-weight: 700;\n    font-size: 17px;\n    text-decoration: none;\n    transition: all 0.2s;\n    position: relative;\n  }\n  .btn-primary::after {\n    content: \u0027\u0027;\n    position: absolute;\n    inset: -4px;\n    border-radius: 12px;\n    border: 1px solid rgba(200,169,110,0.3);\n    animation: ping 2s ease infinite;\n  }\n  .btn-secondary {\n    display: inline-block;\n    border: 1px solid var(--border);\n    color: var(--text);\n    padding: 16px 32px;\n    border-radius: 8px;\n    font-weight: 500;\n    font-size: 17px;\n    text-decoration: none;\n    transition: all 0.2s;\n  }\n  .btn-primary:hover { background: var(--accent2); transform: translateY(-2px); box-shadow: 0 12px 40px rgba(200,169,110,0.3); }\n  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }\n\n  .hero-proof {\n    margin-top: 60px;\n    display: flex;\n    gap: 40px;\n    justify-content: center;\n    flex-wrap: wrap;\n    opacity: 0;\n    animation: fadeUp 0.8s ease 1s forwards;\n  }\n  .proof-item { text-align: center; }\n  .proof-num {\n    font-size: 28px;\n    font-weight: 700;\n    color: var(--accent);\n    display: block;\n  }\n  .proof-label { font-size: 13px; color: var(--muted); }\n\n  /* PAIN SECTION */\n  .section {\n    padding: 100px 24px;\n    max-width: 900px;\n    margin: 0 auto;\n  }\n  .section-wide { max-width: 1100px; }\n\n  .pain {\n    background: var(--bg2);\n    padding: 100px 24px;\n    position: relative;\n    overflow: hidden;\n  }\n  .pain::before {\n    content: \u0027\u0027;\n    position: absolute;\n    left: 0; top: 0; bottom: 0;\n    width: 4px;\n    background: linear-gradient(to bottom, transparent, var(--accent), transparent);\n  }\n  .pain-inner { max-width: 780px; margin: 0 auto; }\n  .pain-intro {\n    font-size: clamp(22px, 4vw, 34px);\n    font-weight: 600;\n    line-height: 1.4;\n    margin-bottom: 40px;\n  }\n  .pain-intro span { color: var(--accent); }\n  .pain-list { list-style: none; display: flex; flex-direction: column; gap: 20px; }\n  .pain-list li {\n    display: flex;\n    gap: 16px;\n    align-items: flex-start;\n    font-size: 18px;\n    color: var(--muted);\n    padding: 20px 24px;\n    background: rgba(255,255,255,0.03);\n    border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 10px;\n    transition: border-color 0.3s;\n  }\n  .pain-list li:hover { border-color: var(--border); }\n  .pain-list li::before { content: \u0027—\u0027; color: var(--accent); flex-shrink: 0; font-weight: 600; }\n\n  /* PROMISE */\n  .promise { padding: 100px 24px; }\n  .promise-inner { max-width: 780px; margin: 0 auto; }\n  .label {\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 20px;\n    display: block;\n  }\n  h2 {\n    font-size: clamp(28px, 4vw, 46px);\n    font-weight: 700;\n    line-height: 1.2;\n    letter-spacing: -0.02em;\n    margin-bottom: 28px;\n  }\n  .promise-text {\n    font-size: 19px;\n    color: var(--muted);\n    margin-bottom: 20px;\n    line-height: 1.8;\n  }\n  .promise-highlight {\n    background: rgba(200,169,110,0.08);\n    border-left: 3px solid var(--accent);\n    padding: 20px 24px;\n    border-radius: 0 8px 8px 0;\n    font-size: 18px;\n    font-style: italic;\n    color: var(--text);\n    margin: 32px 0;\n  }\n\n  /* MODULES */\n  .modules { background: var(--bg2); padding: 100px 24px; }\n  .modules-inner { max-width: 900px; margin: 0 auto; }\n  .modules-header { text-align: center; margin-bottom: 64px; }\n  .modules-grid { display: flex; flex-direction: column; gap: 16px; }\n  .module-card {\n    background: var(--bg3);\n    border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 12px;\n    padding: 24px 28px;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    transition: border-color 0.3s, transform 0.3s;\n    cursor: default;\n  }\n  .module-card:hover {\n    border-color: var(--border);\n    transform: translateX(6px);\n  }\n  .module-num {\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--accent);\n    background: rgba(200,169,110,0.1);\n    width: 40px;\n    height: 40px;\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    letter-spacing: 0.05em;\n  }\n  .module-title { font-size: 17px; font-weight: 600; }\n  .module-desc { font-size: 14px; color: var(--muted); margin-top: 4px; }\n\n  /* INCLUDED */\n  .included { padding: 100px 24px; }\n  .included-inner { max-width: 900px; margin: 0 auto; }\n  .included-header { text-align: center; margin-bottom: 64px; }\n  .included-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 24px;\n  }\n  .included-card {\n    background: var(--bg2);\n    border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 14px;\n    padding: 32px;\n    transition: border-color 0.3s, transform 0.3s;\n  }\n  .included-card:hover { border-color: var(--border); transform: translateY(-4px); }\n  .included-icon { font-size: 28px; margin-bottom: 16px; }\n  .included-card h3 { font-size: 18px; font-weight: 600; margin-bottom: 10px; }\n  .included-card p { font-size: 15px; color: var(--muted); line-height: 1.6; }\n\n  /* FOR WHO */\n  .forwho { background: var(--bg2); padding: 100px 24px; }\n  .forwho-inner { max-width: 780px; margin: 0 auto; }\n  .check-list { list-style: none; display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }\n  .check-list li {\n    display: flex;\n    gap: 14px;\n    align-items: flex-start;\n    font-size: 18px;\n    padding: 16px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.05);\n  }\n  .check-list li:last-child { border-bottom: none; }\n  .check-list li::before { content: \u0027✓\u0027; color: var(--accent); font-weight: 700; flex-shrink: 0; }\n\n  /* PRICE */\n  .price { padding: 100px 24px; }\n  .price-inner { max-width: 640px; margin: 0 auto; }\n  .price-card {\n    background: var(--bg2);\n    border: 1px solid var(--border);\n    border-radius: 20px;\n    padding: 48px;\n    text-align: center;\n    position: relative;\n    overflow: hidden;\n  }\n  .price-card::before {\n    content: \u0027\u0027;\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 3px;\n    background: linear-gradient(90deg, var(--accent), #E8D5A8, var(--accent));\n  }\n  .price-label { font-size: 13px; color: var(--muted); margin-bottom: 16px; }\n  .price-amount {\n    font-size: 64px;\n    font-weight: 700;\n    color: var(--white);\n    line-height: 1;\n    margin-bottom: 8px;\n  }\n  .price-amount span { font-size: 24px; color: var(--muted); vertical-align: super; }\n  .price-tax { font-size: 14px; color: var(--muted); margin-bottom: 40px; }\n  .price-features { list-style: none; text-align: left; margin-bottom: 40px; display: flex; flex-direction: column; gap: 14px; }\n  .price-features li { display: flex; gap: 12px; font-size: 16px; }\n  .price-features li::before { content: \u0027✓\u0027; color: var(--accent); font-weight: 700; }\n  .price-cta {\n    display: block;\n    width: 100%;\n    background: var(--accent);\n    color: #0D0D10;\n    padding: 18px;\n    border-radius: 10px;\n    font-weight: 700;\n    font-size: 18px;\n    text-decoration: none;\n    transition: all 0.2s;\n    margin-bottom: 16px;\n  }\n  .price-cta:hover { background: var(--accent2); transform: translateY(-2px); box-shadow: 0 16px 48px rgba(200,169,110,0.35); }\n  .price-note { font-size: 13px; color: var(--muted); }\n\n  /* FAQ */\n  .faq { background: var(--bg2); padding: 100px 24px; }\n  .faq-inner { max-width: 720px; margin: 0 auto; }\n  .faq-header { text-align: center; margin-bottom: 56px; }\n  .faq-item {\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n    padding: 24px 0;\n    cursor: pointer;\n  }\n  .faq-question {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: 17px;\n    font-weight: 500;\n    gap: 16px;\n  }\n  .faq-toggle {\n    color: var(--accent);\n    font-size: 22px;\n    flex-shrink: 0;\n    transition: transform 0.3s;\n  }\n  .faq-answer {\n    font-size: 16px;\n    color: var(--muted);\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease, padding 0.3s;\n    line-height: 1.7;\n  }\n  .faq-item.open .faq-answer { max-height: 300px; padding-top: 16px; }\n  .faq-item.open .faq-toggle { transform: rotate(45deg); }\n\n  /* FOOTER */\n  footer {\n    padding: 48px 24px;\n    text-align: center;\n    border-top: 1px solid rgba(255,255,255,0.06);\n  }\n  footer p { font-size: 14px; color: var(--muted); margin-bottom: 8px; }\n\n  /* ANIMATIONS */\n  @keyframes fadeUp {\n    from { opacity: 0; transform: translateY(30px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n  @keyframes ping {\n    0%   { transform: scale(1); opacity: 0.6; }\n    80%  { transform: scale(1.15); opacity: 0; }\n    100% { transform: scale(1.15); opacity: 0; }\n  }\n\n  .reveal {\n    opacity: 0;\n    transform: translateY(40px);\n    transition: opacity 0.7s ease, transform 0.7s ease;\n  }\n  .reveal.visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 640px) {\n    nav { padding: 16px 20px; }\n    .hero-cta-group { flex-direction: column; align-items: center; }\n    .btn-primary, .btn-secondary { width: 100%; text-align: center; }\n    .price-card { padding: 32px 24px; }\n    .price-amount { font-size: 48px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation: none !important; transition: none !important; }\n    .reveal { opacity: 1; transform: none; }\n  }\n\u003c/style\u003e\n\n\n\u003c!-- NAV --\u003e\n\u003cnav id=\"nav\"\u003e\n  \u003cdiv class=\"nav-logo\"\u003eNeustart im Kopf\u003c/div\u003e\n  \u003ca href=\"https://app.alfima.com/products/preview/27625\" class=\"nav-cta\"\u003eJetzt starten — 397 €\u003c/a\u003e\n\u003c/nav\u003e\n\n\u003c!-- HERO --\u003e\n\u003csection class=\"hero\"\u003e\n  \u003cdiv class=\"hero-bg\"\u003e\u003c/div\u003e\n  \u003cdiv class=\"hero-content\"\u003e\n    \u003cdiv class=\"hero-badge\"\u003eVideokurs für Unternehmer \u0026amp; Führungskräfte 50+\u003c/div\u003e\n    \u003ch1\u003eDu funktionierst.\u003cbr\u003eAber \u003cspan\u003ewie lange noch?\u003c/span\u003e\u003c/h1\u003e\n    \u003cp class=\"hero-sub\"\u003e\n      Kein Coaching. Keine Motivationssprüche. Nur Klarheit darüber, was wirklich hinter deiner Unruhe steckt — und wie du wieder Stabilität aufbaust.\n    \u003c/p\u003e\n    \u003cdiv class=\"hero-cta-group\"\u003e\n      \u003ca href=\"https://app.alfima.com/products/preview/27625\" class=\"btn-primary\"\u003eJetzt Kurs starten — 397 €\u003c/a\u003e\n      \u003ca href=\"#kurs\" class=\"btn-secondary\"\u003eWas erwartet mich?\u003c/a\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"hero-proof\"\u003e\n      \u003cdiv class=\"proof-item\"\u003e\n        \u003cspan class=\"proof-num\" data-count=\"9\"\u003e0\u003c/span\u003e\n        \u003cspan class=\"proof-label\"\u003eModule\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"proof-item\"\u003e\n        \u003cspan class=\"proof-num\"\u003eSofort\u003c/span\u003e\n        \u003cspan class=\"proof-label\"\u003everfügbar\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"proof-item\"\u003e\n        \u003cspan class=\"proof-num\"\u003eDein\u003c/span\u003e\n        \u003cspan class=\"proof-label\"\u003eTempo\u003c/span\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PAIN --\u003e\n\u003csection class=\"pain\"\u003e\n  \u003cdiv class=\"pain-inner reveal\"\u003e\n    \u003cp class=\"pain-intro\"\u003e\n      Du führst ein Unternehmen. Du lieferst. Du funktionierst.\u003cbr\u003e\n      Aber innerlich merkst du: \u003cspan\u003eSo geht es nicht mehr weiter.\u003c/span\u003e\n    \u003c/p\u003e\n    \u003cul class=\"pain-list\"\u003e\n      \u003cli\u003eDu bist müde — nicht vom Schlafen, sondern vom Dauerdruck und ständigen Aushalten\u003c/li\u003e\n      \u003cli\u003eDu treibst dich innerlich an, obwohl du eigentlich längst angekommen sein müsstest\u003c/li\u003e\n      \u003cli\u003eDu weißt, dass irgendetwas nicht stimmt — aber du kannst es nicht greifen\u003c/li\u003e\n      \u003cli\u003eDu willst keine Therapie, keinen Coach, keine weiteren To-dos — du willst Klarheit\u003c/li\u003e\n    \u003c/ul\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PROMISE --\u003e\n\u003csection class=\"promise\"\u003e\n  \u003cdiv class=\"promise-inner reveal\"\u003e\n    \u003cspan class=\"label\"\u003eKein Blabla. Kein Druck.\u003c/span\u003e\n    \u003ch2\u003eDu bekommst Klarheit.\u003cbr\u003eNicht Motivation.\u003c/h2\u003e\n    \u003cp class=\"promise-text\"\u003e\n      Dieser Kurs ist kein Programm, das dich antreibt. Er ist ein Werkzeug, das dir hilft zu verstehen, was hinter deiner Unruhe steckt — damit du nicht mehr gegen dich arbeitest, sondern mit dir.\n    \u003c/p\u003e\n    \u003cdiv class=\"promise-highlight\"\u003e\n      „Keine klassischen Stress-Tipps, die nach zwei Tagen verpuffen. Du erkennst, was wirklich passiert — und wie du wieder Stabilität aufbaust, ohne dich zu verbiegen.\"\n    \u003c/div\u003e\n    \u003cp class=\"promise-text\"\u003e\n      Du arbeitest dich Schritt für Schritt voran: von der ehrlichen Bestandsaufnahme, über das Verstehen deiner Muster, bis hin zu konkreten Veränderungen im Alltag.\n    \u003c/p\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- MODULES --\u003e\n\u003csection class=\"modules\" id=\"kurs\"\u003e\n  \u003cdiv class=\"modules-inner\"\u003e\n    \u003cdiv class=\"modules-header reveal\"\u003e\n      \u003cspan class=\"label\"\u003eKursinhalt\u003c/span\u003e\n      \u003ch2\u003e9 Module. Klar strukturiert.\u003c/h2\u003e\n      \u003cp style=\"color: var(--muted); font-size: 18px; margin-top: 16px;\"\u003eJedes Modul baut auf dem vorherigen auf — von der Frage, was hier wirklich passiert, bis zum Dranbleiben ohne Druck.\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"modules-grid\"\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e01\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eWas hier wirklich passiert\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eEhrliche Bestandsaufnahme — ohne Schönreden\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e02\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eDein ehrlicher Standort\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eWo stehst du wirklich — jenseits von Zahlen und Leistung\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e03\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eWas dich antreibt — und warum das erschöpft\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eDie Muster hinter dem inneren Druck verstehen\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e04\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eInnere Ordnung schaffen\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eGedanken sortieren, Prioritäten klären, Kopf entlasten\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e05\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eBeziehungen und Umfeld\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eWas dich zieht, was dich zieht — und was du loslassen kannst\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e06\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eDas Grübeln unterbrechen\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eKonkrete Techniken für den Kopf, der nicht abschalten kann\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e07\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eMentale Entlastung im Alltag\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eAlltagstaugliche Routinen ohne neue Verpflichtungen\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e08\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eStabilität aufbauen\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eNicht Perfektion — sondern ein Fundament das trägt\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"module-card reveal\"\u003e\n        \u003cdiv class=\"module-num\"\u003e09\u003c/div\u003e\n        \u003cdiv\u003e\n          \u003cdiv class=\"module-title\"\u003eDranbleiben ohne Druck\u003c/div\u003e\n          \u003cdiv class=\"module-desc\"\u003eWie du weitermachst — in deinem Tempo, nachhaltig\u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- INCLUDED --\u003e\n\u003csection class=\"included\"\u003e\n  \u003cdiv class=\"included-inner\"\u003e\n    \u003cdiv class=\"included-header reveal\"\u003e\n      \u003cspan class=\"label\"\u003eIm Kurs enthalten\u003c/span\u003e\n      \u003ch2\u003eAlles was du brauchst. Nichts was du nicht brauchst.\u003c/h2\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"included-grid\"\u003e\n      \u003cdiv class=\"included-card reveal\"\u003e\n        \u003cdiv class=\"included-icon\"\u003e🎬\u003c/div\u003e\n        \u003ch3\u003eVideokurs mit 9 Modulen\u003c/h3\u003e\n        \u003cp\u003eKompakte Lektionen, direkt umsetzbar. Du schaust, wann und wo es dir passt.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"included-card reveal\"\u003e\n        \u003cdiv class=\"included-icon\"\u003e📄\u003c/div\u003e\n        \u003ch3\u003eZusammenfassungen \u0026 Downloads\u003c/h3\u003e\n        \u003cp\u003eJedes Modul mit Zusammenfassung zum Nachlesen und Mitnehmen.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"included-card reveal\"\u003e\n        \u003cdiv class=\"included-icon\"\u003e📝\u003c/div\u003e\n        \u003ch3\u003eArbeitsblätter \u0026 Vorlagen\u003c/h3\u003e\n        \u003cp\u003eEinfache Vorlagen zur Selbstreflexion und Wochenroutine — ohne Overhead.\u003c/p\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"included-card reveal\"\u003e\n        \u003cdiv class=\"included-icon\"\u003e🔓\u003c/div\u003e\n        \u003ch3\u003eSofort \u0026 dauerhaft verfügbar\u003c/h3\u003e\n        \u003cp\u003eDu kaufst einmalig und hast dauerhaften Zugriff — komplett in deinem Tempo.\u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FOR WHO --\u003e\n\u003csection class=\"forwho\"\u003e\n  \u003cdiv class=\"forwho-inner reveal\"\u003e\n    \u003cspan class=\"label\"\u003eFür wen ist das?\u003c/span\u003e\n    \u003ch2\u003eDieser Kurs ist für dich, wenn…\u003c/h2\u003e\n    \u003cul class=\"check-list\"\u003e\n      \u003cli\u003eDu selbstständig, Unternehmer oder Führungskraft bist und nach außen funktionierst\u003c/li\u003e\n      \u003cli\u003eDu innerlich merkst, dass irgendetwas nicht mehr stimmt — aber nicht weißt was\u003c/li\u003e\n      \u003cli\u003eDu keine Lust auf Motivationssprüche, Coaching oder Community hast\u003c/li\u003e\n      \u003cli\u003eDu in deinem eigenen Tempo lernen möchtest — unabhängig und ohne Druck\u003c/li\u003e\n      \u003cli\u003eDu bereit bist, ehrlich hinzuschauen — auch wenn das unbequem ist\u003c/li\u003e\n    \u003c/ul\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- PRICE --\u003e\n\u003csection class=\"price\"\u003e\n  \u003cdiv class=\"price-inner\"\u003e\n    \u003cdiv class=\"price-card reveal\"\u003e\n      \u003cp class=\"price-label\"\u003eEinmalig. Dauerhaft. Dein Tempo.\u003c/p\u003e\n      \u003cdiv class=\"price-amount\"\u003e\u003cspan\u003e€\u003c/span\u003e397\u003c/div\u003e\n      \u003cp class=\"price-tax\"\u003einkl. MwSt. — einmalige Zahlung, kein Abo\u003c/p\u003e\n      \u003cul class=\"price-features\"\u003e\n        \u003cli\u003eVideokurs mit 9 kompakten Modulen\u003c/li\u003e\n        \u003cli\u003eMehrere Lektionen pro Modul, direkt umsetzbar\u003c/li\u003e\n        \u003cli\u003eZusammenfassungen \u0026 Downloads\u003c/li\u003e\n        \u003cli\u003eArbeitsblätter \u0026 Vorlagen zur Selbstreflexion\u003c/li\u003e\n        \u003cli\u003eSofort nach Kauf vollständig verfügbar\u003c/li\u003e\n        \u003cli\u003eTechnischer Support bei Problemen per E-Mail\u003c/li\u003e\n      \u003c/ul\u003e\n      \u003ca href=\"https://app.alfima.com/products/preview/27625\" class=\"price-cta\"\u003eJetzt Zugang sichern\u003c/a\u003e\n      \u003cp class=\"price-note\"\u003eKein Coaching, keine Community, keine Live-Calls. Reiner Selbstlernkurs.\u003c/p\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FAQ --\u003e\n\u003csection class=\"faq\"\u003e\n  \u003cdiv class=\"faq-inner\"\u003e\n    \u003cdiv class=\"faq-header reveal\"\u003e\n      \u003cspan class=\"label\"\u003eFragen\u003c/span\u003e\n      \u003ch2\u003eHäufige Fragen\u003c/h2\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"faq-item reveal\"\u003e\n      \u003cdiv class=\"faq-question\"\u003e\n        Für wen ist dieser Kurs geeignet?\n        \u003cspan class=\"faq-toggle\"\u003e+\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"faq-answer\"\u003e\n        Für Selbstständige, Unternehmer und Führungskräfte, die nach außen funktionieren, aber innerlich spüren, dass so nicht mehr weitergeht. Kein bestimmtes Vorwissen notwendig.\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"faq-item reveal\"\u003e\n      \u003cdiv class=\"faq-question\"\u003e\n        Wie lange habe ich Zugang zum Kurs?\n        \u003cspan class=\"faq-toggle\"\u003e+\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"faq-answer\"\u003e\n        Du kaufst einmalig und erhältst dauerhaften Zugang. Es gibt keine zeitliche Begrenzung — du lernst komplett in deinem eigenen Tempo.\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"faq-item reveal\"\u003e\n      \u003cdiv class=\"faq-question\"\u003e\n        Gibt es persönliche Betreuung oder Coaching?\n        \u003cspan class=\"faq-toggle\"\u003e+\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"faq-answer\"\u003e\n        Nein — bewusst nicht. Dieser Kurs ist ein reiner Selbstlernkurs ohne Coaching, Community oder Live-Calls. Das ist kein Manko, sondern Programm: Du brauchst keinen weiteren Menschen, der dir sagt, was du tun sollst.\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"faq-item reveal\"\u003e\n      \u003cdiv class=\"faq-question\"\u003e\n        Was unterscheidet das von anderen Stressbewältigungs-Kursen?\n        \u003cspan class=\"faq-toggle\"\u003e+\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"faq-answer\"\u003e\n        Du bekommst keine Motivationssprüche und keine klassischen Stress-Tipps, die nach zwei Tagen verpuffen. Der Fokus liegt auf ehrlichem Verstehen: Was steckt wirklich hinter der Unruhe? Erst dann folgt Veränderung.\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"faq-item reveal\"\u003e\n      \u003cdiv class=\"faq-question\"\u003e\n        Wann bin ich nach dem Kauf startklar?\n        \u003cspan class=\"faq-toggle\"\u003e+\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class=\"faq-answer\"\u003e\n        Sofort. Nach dem Kauf hast du unmittelbaren Zugriff auf alle Module und Lektionen.\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n\u003c/section\u003e\n\n\u003c!-- FOOTER --\u003e\n\u003cfooter\u003e\n  \u003cp style=\"color: var(--accent); font-weight: 600; margin-bottom: 16px;\"\u003eNeustart im Kopf\u003c/p\u003e\n  \u003cp\u003eEin Kurs von Andreas Stock · fin.affairs.anst@gmail.com\u003c/p\u003e\n  \u003cp style=\"margin-top: 8px; font-size: 12px;\"\u003e© 2026 Andreas Stock · Alle Rechte vorbehalten\u003c/p\u003e\n\u003c/footer\u003e\n\n\u003cscript\u003e\n  // Nav scroll effect\n  const nav = document.getElementById(\u0027nav\u0027);\n  window.addEventListener(\u0027scroll\u0027, () =\u003e {\n    nav.classList.toggle(\u0027scrolled\u0027, window.scrollY \u003e 50);\n  });\n\n  // Reveal on scroll\n  const reveals = document.querySelectorAll(\u0027.reveal\u0027);\n  const observer = new IntersectionObserver((entries) =\u003e {\n    entries.forEach((entry, i) =\u003e {\n      if (entry.isIntersecting) {\n        setTimeout(() =\u003e entry.target.classList.add(\u0027visible\u0027), i * 60);\n        observer.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.1, rootMargin: \u00270px 0px -40px 0px\u0027 });\n  reveals.forEach(el =\u003e observer.observe(el));\n\n  // Counter animation\n  const counters = document.querySelectorAll(\u0027[data-count]\u0027);\n  const countObserver = new IntersectionObserver((entries) =\u003e {\n    entries.forEach(entry =\u003e {\n      if (entry.isIntersecting) {\n        const target = parseInt(entry.target.dataset.count);\n        let current = 0;\n        const step = target / 30;\n        const timer = setInterval(() =\u003e {\n          current += step;\n          if (current \u003e= target) { current = target; clearInterval(timer); }\n          entry.target.textContent = Math.round(current);\n        }, 40);\n        countObserver.unobserve(entry.target);\n      }\n    });\n  });\n  counters.forEach(el =\u003e countObserver.observe(el));\n\n  // FAQ accordion\n  document.querySelectorAll(\u0027.faq-item\u0027).forEach(item =\u003e {\n    item.querySelector(\u0027.faq-question\u0027).addEventListener(\u0027click\u0027, () =\u003e {\n      const isOpen = item.classList.contains(\u0027open\u0027);\n      document.querySelectorAll(\u0027.faq-item\u0027).forEach(i =\u003e i.classList.remove(\u0027open\u0027));\n      if (!isOpen) item.classList.add(\u0027open\u0027);\n    });\n  });\n\u003c/script\u003e\n"},"status":"publish","slug":"neustart-im-kopf","template":"elementor_canvas"}